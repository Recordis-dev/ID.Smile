{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(dx|diagnostico|dashboard|bmc|hub)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(dx-digital-smile-ortodoncia|dashboard-operativo-id-smile|business-model-canvas-id-smile|hub).html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)\\.md",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/diagnosticadoc/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/(index|index.html)",
      "dest": "/index.html"
    },
    {
      "src": "/v1",
      "dest": "/v1.html"
    },
    {
      "src": "/dx",
      "dest": "/dx-digital-smile-ortodoncia.html"
    },
    {
      "src": "/diagnostico",
      "dest": "/dx-digital-smile-ortodoncia.html"
    },
    {
      "src": "/dashboard",
      "dest": "/dashboard-operativo-id-smile.html"
    },
    {
      "src": "/bmc",
      "dest": "/business-model-canvas-id-smile.html"
    },
    {
      "src": "/hub",
      "dest": "/hub.html"
    }
  ]
}
